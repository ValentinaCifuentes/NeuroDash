# Base de la API de NeuroDash CORE (FastAPI).
# Si se deja vacía o sin definir, el frontend usa src/mocks/mockBackend.ts:
# responde como FastAPI con las demos PAC-A/B/C exportadas de la demo real
# (scripts/export_mock_fixture.py). NO es el motor: no recalcula la estimación.
VITE_API_BASE=http://localhost:8000

# Actor fijo con el que el frontend guarda registros, eventos y resultados
# (cabeceras X-Actor-Id / X-Actor-Role). Sin definir: tutor-demo / tutor.
VITE_ACTOR_ID=tutor-demo
VITE_ACTOR_ROLE=tutor
